{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/radio/stream", "destination": "http://15.229.83.121:8000/alce.mp3" }],
  "headers": [
    { "source": "/radio/stream", "headers": [
      { "key": "Cache-Control", "value": "no-store, no-cache" },
      { "key": "CDN-Cache-Control", "value": "no-store" },
      { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
    ]},
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
    ]}
  ]
}
